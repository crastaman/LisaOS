# LisaOS / OpenClaw provider credentials — TEMPLATE ONLY
# =====================================================================
# DO NOT put real secrets in this file. This template is committed; real
# values are NOT. Copy the variables you need into the runtime env file:
#
#     ~/.openclaw/.env        (read by the OpenClaw gateway AND by
#                              core.provider_resolver's credential check)
#
# or export them in your shell. Never commit a populated .env.
# =====================================================================

# Qwen on DeepInfra (logical provider: qwen-deepinfra)
# Required for qwen-deepinfra to resolve AVAILABLE; absent => fails closed.
# Get a key from https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Qwen on Alibaba Model Studio (logical provider: qwen-alibaba)
MODEL_STUDIO_API_KEY=

# Z.AI / GLM (optional builder provider)
ZAI_API_KEY=

# Note: the following providers use OAuth or an inline key already present in
# ~/.openclaw/openclaw.json and do NOT need an env var here:
#   deepseek      (inline apiKey in openclaw.json provider block)
#   claude-opus   (OAuth: anthropic:claude-cli)
#   claude-sonnet (OAuth: anthropic:claude-cli)
#   codex, gpt    (OAuth: openai)

# =====================================================================
# Lisa Console (docs/LISAOS/CONSOLE/) — advisory only, never the
# dispatcher/workforce execution path. Distinct from the OAuth-based 'gpt'
# workforce provider above.
# =====================================================================

# Direct OpenAI API key for GPT Advisor executive-brief generation
# (advisors/openai_client.py). Read from the environment only -- never
# logged, never written to a bundle or brief. If unset, the Advisor fails
# closed and produces a degraded brief rather than attempting a call.
LISA_CONSOLE_OPENAI_API_KEY=

# OpenAI model the GPT Advisor calls. Optional -- defaults to
# advisors.openai_client.DEFAULT_MODEL if unset. A configuration value,
# not an architectural coupling (docs/GPT_CONTEXT/09_ARCHITECTURAL_CONSTRAINTS.md).
LISA_CONSOLE_OPENAI_MODEL=

# ntfy.sh topic (long random string) Lisa Console pushes decision
# notifications to, and its optional access token (advisors/notify.py).
# If LISA_CONSOLE_NTFY_TOPIC is unset, send_notification() fails closed
# with category "not_configured" -- no network call is attempted, and
# this never blocks brief generation or Console usability.
LISA_CONSOLE_NTFY_TOPIC=
LISA_CONSOLE_NTFY_TOKEN=

# ntfy server base URL. Optional -- defaults to https://ntfy.sh
# (advisors.notify.DEFAULT_NTFY_SERVER) if unset. This is the entire
# "provider abstraction for future self-hosted migration": point this at
# a self-hosted ntfy instance on the tailnet and nothing else in
# advisors/notify.py needs to change.
LISA_CONSOLE_NTFY_SERVER=

# Base URL (Tailscale MagicDNS, once tailscale serve deployment -- Phase
# C5 -- is set up) used only to build the notification's
# console_deep_link, e.g. https://lisa.<tailnet>.ts.net. Optional -- if
# unset, notifications omit the deep link rather than failing.
LISA_CONSOLE_BASE_URL=

# Comma-separated allowlist of Tailscale identities (Tailscale-User-Login
# values) allowed to view/approve/reject in the Console
# (console/auth.py). Requests from any other identity -- or from no
# identity at all -- are rejected and audited. Unset or empty means the
# allowlist is empty: fails closed, denies everyone, never fails open.
# Example: roshan@example.ts.net,roshan-phone@example.ts.net
LISA_CONSOLE_OWNER_IDENTITY=
