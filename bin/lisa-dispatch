#!/usr/bin/env python3
"""lisa-dispatch — run a goal (a set of work packages + dependencies) through
the LisaOS Phase 2 ready-frontier scheduler + Phase 3 policy engine and
report the result.

Usage:
    lisa-dispatch run <goal.json> [--max-concurrency N] [--max-per-provider N]
                                  [--ledger-path PATH]

goal.json shape:
    [
      {"id": "a", "description": "...", "required_capabilities": ["architecture"],
       "risk": "normal", "mode": "balanced", "depends_on": []},
      ...
    ]

`mode` (Phase 3, default "balanced") selects a registry/workforce_modes.yml
policy bundle -- which employees are eligible and how cost/subscription
should be traded off. Staffing also consults the persistent Capacity Ledger
(reports/lisa/capacity_ledger.json by default; override with --ledger-path
for a scratch ledger, e.g. in demos) so historically unhealthy/exhausted/
probationary capacity is excluded before a live provider call is even made.
Every real execution outcome feeds back into the ledger via
`ledger_recording_executor`.

EXECUTION MODE (Phase 4 remediation -- see
reports/lisa/PHASE4_IMPLEMENTATION_REPORT.md): by default this dispatches
REAL work through core.openclaw_bridge -- an actual `openclaw agent` spawn
per package, verified against ~/.openclaw/state/openclaw.sqlite. This SPENDS
REAL MONEY/QUOTA. Pass --simulate to explicitly opt into the old hermetic
Phase 2 simulated_executor (no network, no spend); every assignment produced
in that mode is stamped execution_evidence_source="SIMULATED-NOT-EXECUTED"
in the evidence log, and the report prints an unmistakable SIMULATED banner.
Real execution never silently falls back to simulation -- an unreachable
gateway or a physical model with no eligible non-WBS OpenClaw agent bound to
it fails that package closed, with a recorded reason.

Exit codes:
    0  dispatch completed and all anti-regression gates passed
    2  dispatch had per-package fail-closed errors (unstaffable work)
    3  anti-regression gates failed
"""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from core.provider_resolver import ProviderResolver  # noqa: E402
from core.workforce_resolver import EmployeeRegistry, WorkPackage  # noqa: E402
from core.workforce_modes import WorkforceModeRegistry  # noqa: E402
from core.capacity_ledger import CapacityLedger, ledger_recording_executor  # noqa: E402
from core.policy_engine import PolicyEngine  # noqa: E402
from core.dependency_graph import DependencyGraph, GraphError  # noqa: E402
from core.dispatcher import Dispatcher  # noqa: E402
from core.anti_regression import run_policy_gates, FAIL  # noqa: E402
from core.openclaw_bridge import (  # noqa: E402
    build_real_executor, labelled_simulated_executor,
    DEFAULT_TIMEOUT_SECONDS, SIMULATED_LABEL,
)
from core.work_product import (  # noqa: E402
    build_no_execution_work_product, work_product_recording_executor,
    write_work_product,
)
from core.auto_resume import advance_pipeline, build_graph_state, write_graph_state  # noqa: E402
from core.graph_state_store import mission_id_for_goal, scoped_graph_state_path  # noqa: E402
import os  # noqa: E402


def _load_goal(path: str) -> list[WorkPackage]:
    data = json.loads(Path(path).read_text())
    return [
        WorkPackage(
            id=item["id"],
            description=item.get("description", ""),
            required_capabilities=list(item.get("required_capabilities", [])),
            risk=item.get("risk", "normal"),
            mode=item.get("mode", "balanced"),
            depends_on=list(item.get("depends_on", [])),
        )
        for item in data
    ]


def cmd_run(argv: list[str]) -> int:
    if not argv:
        print("usage: lisa-dispatch run <goal.json> [--max-concurrency N] "
              "[--max-per-provider N] [--ledger-path PATH] [--simulate] "
              "[--timeout-per-task SECONDS]")
        return 2
    goal_path = argv[0]
    max_concurrency = 8
    max_per_provider = 3
    ledger_path = None
    simulate = False
    timeout_per_task = DEFAULT_TIMEOUT_SECONDS
    # Phase 3 (LISA-I005): Work Product evidence capture. On by default so every
    # executed package yields deterministic evidence; --no-work-product opts out.
    repo_path = None
    job_id = None
    sprint = None
    capture_work_products = True
    auto_resume = False
    rest = argv[1:]
    i = 0
    while i < len(rest):
        if rest[i] == "--max-concurrency" and i + 1 < len(rest):
            max_concurrency = int(rest[i + 1]); i += 2
        elif rest[i] == "--max-per-provider" and i + 1 < len(rest):
            max_per_provider = int(rest[i + 1]); i += 2
        elif rest[i] == "--ledger-path" and i + 1 < len(rest):
            ledger_path = Path(rest[i + 1]); i += 2
        elif rest[i] == "--simulate":
            simulate = True; i += 1
        elif rest[i] == "--timeout-per-task" and i + 1 < len(rest):
            timeout_per_task = int(rest[i + 1]); i += 2
        elif rest[i] == "--repo" and i + 1 < len(rest):
            repo_path = rest[i + 1]; i += 2
        elif rest[i] == "--job-id" and i + 1 < len(rest):
            job_id = rest[i + 1]; i += 2
        elif rest[i] == "--sprint" and i + 1 < len(rest):
            sprint = rest[i + 1]; i += 2
        elif rest[i] == "--no-work-product":
            capture_work_products = False; i += 1
        elif rest[i] == "--auto-resume":
            auto_resume = True; i += 1
        else:
            i += 1

    try:
        packages = _load_goal(goal_path)
        graph = DependencyGraph.from_packages(packages)
    except (GraphError, KeyError, json.JSONDecodeError, OSError) as exc:
        print(json.dumps({"error": f"invalid goal: {exc}"}, indent=2))
        return 2

    resolver = ProviderResolver()
    modes = WorkforceModeRegistry()
    ledger = CapacityLedger.at_path(ledger_path) if ledger_path is not None else CapacityLedger()
    policy = PolicyEngine(EmployeeRegistry(), resolver, modes, ledger)

    if simulate:
        inner_executor = labelled_simulated_executor
        execution_mode = SIMULATED_LABEL
        print(f"*** EXECUTION MODE: {SIMULATED_LABEL} "
              f"(--simulate passed; no real spawn, no spend) ***\n", file=sys.stderr)
    else:
        inner_executor = build_real_executor(timeout_seconds=timeout_per_task, resolver=resolver)
        execution_mode = "REAL"
        print("*** EXECUTION MODE: REAL (openclaw bridge; spends real money/quota) ***\n",
              file=sys.stderr)

    # Executor stack (outermost last): real/simulated -> capacity ledger ->
    # work-product capture. Each layer inherits the innermost declared
    # provenance and returns the ExecutionResult unmodified, so the Dispatcher
    # remains the sole execution authority and no parallel path is introduced.
    staged_executor = ledger_recording_executor(ledger, inner=inner_executor)
    if capture_work_products:
        staged_executor = work_product_recording_executor(
            staged_executor,
            repo=repo_path,
            context={"job_id": job_id, "sprint": sprint,
                     "goal_path": goal_path, "execution_mode": execution_mode},
        )

    lisa_base = Path(os.environ.get("LISA_HOME", Path.home() / "Lisa"))
    # RC004 Wave 1: reconciliation admission is mandatory for real dispatch
    # whenever durable orchestration state exists. --auto-resume still controls
    # pre-dispatch resume behavior, but the dispatcher always receives the
    # durable state path so EXECUTION_UNKNOWN cannot be redispatched by bypassing
    # the resume wrapper.
    graph_state_base = lisa_base / "reports" / "lisa" / "orchestration" / "graph_state.json"
    mission_id = mission_id_for_goal(goal_path)
    graph_state_path = str(scoped_graph_state_path(graph_state_base, mission_id))
    dispatcher = Dispatcher(policy, executor=staged_executor,
                            max_concurrency=max_concurrency,
                            max_per_provider=max_per_provider,
                            graph_state_path=graph_state_path,
                            mission_id=mission_id)
    report = dispatcher.run(graph)

    # LISA-I012 (DEFECT-3): a package refused BEFORE execution never reaches the
    # executor, so the capture wrapper never runs and it produced no Work
    # Product -- vanishing from review bundles, synthesis and operator reports.
    # Emit an authoritative No-Execution Work Product for those packages, derived
    # entirely from the dispatcher's OWN assignment evidence. This is reporting
    # only: nothing here can cause execution, and the dispatcher remains the sole
    # execution authority.
    if capture_work_products:
        for pkg_id, assignment in report.assignments.items():
            record = assignment.to_dict()
            if record.get("execution_provenance") is not None:
                continue  # execution began -- the wrapper already recorded it
            try:
                write_work_product(
                    build_no_execution_work_product(
                        package_id=pkg_id,
                        assignment=record,
                        repo=repo_path,
                        context={"job_id": job_id, "sprint": sprint,
                                 "goal_path": goal_path,
                                 "execution_mode": execution_mode},
                    ),
                )
            except Exception as exc:  # never let reporting break a dispatch
                print(f"WARNING: could not record no-execution work product for "
                      f"{pkg_id}: {exc!r}", file=sys.stderr)

    payload = report.to_dict()
    payload["execution_mode"] = execution_mode
    print(json.dumps(payload, indent=2, default=str))

    gates = run_policy_gates(report, modes, resolver)
    print("\n--- anti-regression gates ---")
    for r in gates.results:
        print(f"[{r.severity}] {r.name}: {r.detail}")

    # -- auto-resume: persist state + escalate if needed -------------------
    auto_resume_decision = None
    if auto_resume:
        # Collect task_run run_ids from this dispatch cycle for HWM scoping.
        dispatched_run_ids: list[str] = []
        for assignment in report.assignments.values():
            rid = getattr(assignment, "execution_run_id", None)
            if rid:
                dispatched_run_ids.append(rid)

        state = build_graph_state(graph, goal_path,
                                  mission_run_ids=dispatched_run_ids or None)
        write_graph_state(state, Path(graph_state_path))
        packages_meta = {pkg.id: {"risk": pkg.risk} for pkg in packages}
        auto_resume_decision = advance_pipeline(
            goal_path, graph=graph, packages_meta=packages_meta,
            new_run_ids=dispatched_run_ids or None,
            graph_state_path=Path(graph_state_path),
        )
        print(f"\n--- auto-resume: {auto_resume_decision} ---", file=sys.stderr)

    if report.errors:
        print(f"\n{len(report.errors)} package(s) failed to staff/execute (fail-closed).")
        return 2 if gates.passed else 3
    if not gates.passed:
        return 3
    return 0


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "run":
        return cmd_run(rest)
    print(f"unknown command: {cmd}")
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
